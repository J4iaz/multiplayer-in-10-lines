# Port (Render sets automatically)
PORT=3000
# Room TTL in memory
ROOM_TTL_MINUTES=60
# Supabase (server-side - service role key is SECRET, never expose to browser)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Anthropic AI (server-side only, NEVER expose)
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-5
AI_MAX_OUTPUT_TOKENS=1500
AI_REQUESTS_PER_USER_PER_HOUR=30
# WebRTC TURN/STUN servers
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=
STUN_URLS=stun:stun.l.google.com:19302
# Auth
ALLOW_GUESTS=true
MAX_VIDEO_PEERS=6
APP_ORIGIN=http://localhost:3000